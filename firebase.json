{
  "firestore": [
    {
      "database": "ai-studio-57118877-ceb5-4cf7-9e31-c5f548597a37",
      "rules": "firestore.rules"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.wasm",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/staff/access-request",
        "run": {
          "serviceId": "staff-api",
          "region": "us-west1"
        }
      },
      {
        "source": "/api/staff/access-request/**",
        "run": {
          "serviceId": "staff-api",
          "region": "us-west1"
        }
      },
      {
        "source": "/api/staff/access-requests",
        "run": {
          "serviceId": "staff-api",
          "region": "us-west1"
        }
      },
      {
        "source": "/api/staff/access-requests/**",
        "run": {
          "serviceId": "staff-api",
          "region": "us-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
